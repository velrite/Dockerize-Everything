# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_USER=appuser
POSTGRES_PASSWORD=
POSTGRES_DB=appdb
 
# ── Flask ────────────────────────────────────────────────────────────────
FLASK_APP_ENV=production
 
# ── Node ─────────────────────────────────────────────────────────────────
NODE_DB_HOST=postgres
NODE_DB_PORT=5432
NODE_DB_NAME=appdb
NODE_DB_USER=appuser
NODE_DB_PASSWORD=
 
# ── Superset ─────────────────────────────────────────────────────────────
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=
DATABASE_URL=postgresql+psycopg2://appuser:CHANGE_ME@postgres:5432/appdb
REDIS_URL=redis://redis:6379/0


